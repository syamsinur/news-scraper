# Menggunakan image Python resmi yang ringan
FROM python:3.11-slim

# Set direktori kerja di dalam container
WORKDIR /app

# Install dependencies sistem jika dibutuhkan oleh lxml atau curl-cffi
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Salin file requirements.txt ke dalam container
COPY requirements.txt .

# Install semua library Python
RUN pip install --no-cache-dir -r requirements.txt

# Salin seluruh file proyek ke dalam container
COPY . .

# Hugging Face mewajibkan port 7860
EXPOSE 7860

# Jalankan Uvicorn dengan target file FastAPI kamu
# Sesuaikan 'src.news_scraper.main:app' dengan struktur foldermu
CMD ["uvicorn", "src.news_scraper.main:app", "--host", "0.0.0.0", "--port", "7860"]